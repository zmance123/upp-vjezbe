        <bpmn:flowNodeRef>U_Tm2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_Sub2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pool_Uni_2" name="Pravna služba">
        <bpmn:flowNodeRef>U_T7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="U_Start" name="Zaprimljene rang-liste iz NISpVU">
      <bpmn:outgoing>Flow_Pool_Uni_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="U_Start_def" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="U_GA" name="">
      <bpmn:incoming>Flow_Pool_Uni_1</bpmn:incoming>
      <bpmn:incoming>Flow_Pool_Uni_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="U_T1" name="Provjeriti dostavljenu dokumentaciju">
      <bpmn:incoming>Flow_Pool_Uni_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="U_G1" name="Dokumentacija ispravna?">
      <bpmn:incoming>Flow_Pool_Uni_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pool_Uni_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="U_T2" name="Obavijestiti NISpVU o nedostacima">
      <bpmn:incoming>Flow_Pool_Uni_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="U_T3" name="Zaprimiti dorađenu dokumentaciju">
      <bpmn:incoming>Flow_Pool_Uni_5</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_6</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:subProcess id="U_Sub1" name="Evaluacija kandidata">
      <bpmn:incoming>Flow_Pool_Uni_7</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_8</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:serviceTask id="U_T4" name="Generirati konačne rang-liste">
      <bpmn:incoming>Flow_Pool_Uni_8</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="U_T5" name="Obavijestiti kandidate o rezultatima">
      <bpmn:incoming>Flow_Pool_Uni_9</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="U_Tm1" name="Istekao rok za žalbe">
      <bpmn:incoming>Flow_Pool_Uni_10</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_11</bpmn:outgoing>
      <bpmn:timerEventDefinition id="U_Tm1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="U_G2" name="Pristigle žalbe?">
      <bpmn:incoming>Flow_Pool_Uni_11</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pool_Uni_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="U_GB" name="">
      <bpmn:incoming>Flow_Pool_Uni_12</bpmn:incoming>
      <bpmn:incoming>Flow_Pool_Uni_19</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_T6" name="Razmotriti žalbu (prihvatiti ili odbiti)">
      <bpmn:incoming>Flow_Pool_Uni_14</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U_G3" name="Složena žalba?">
      <bpmn:incoming>Flow_Pool_Uni_15</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pool_Uni_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_T7" name="Odlučiti o ponovnom bodovanju ili drugoj metodi evaluacije">
      <bpmn:incoming>Flow_Pool_Uni_16</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="U_G4" name="Sve žalbe riješene?">
      <bpmn:incoming>Flow_Pool_Uni_17</bpmn:incoming>
      <bpmn:incoming>Flow_Pool_Uni_18</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pool_Uni_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="U_T8" name="Objaviti konačne rang-liste">
      <bpmn:incoming>Flow_Pool_Uni_13</bpmn:incoming>
      <bpmn:incoming>Flow_Pool_Uni_20</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="U_Tm2" name="Završen jesenski upisni rok">
      <bpmn:incoming>Flow_Pool_Uni_26</bpmn:incoming>
      <bpmn:outgoing>Flow_Pool_Uni_27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="U_Tm2_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="U_End" name="Upisi završeni">
      <bpmn:incoming>Flow_Pool_Uni_27</bpmn:incoming>
    </bpmn:endEvent>
