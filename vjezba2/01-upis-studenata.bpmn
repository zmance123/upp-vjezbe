  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_NISpVU" name="NISpVU (Postani student)" />
    <bpmn:participant id="Pool_Uni" name="Sveučilište" processRef="Process_Pool_Uni" />
    <bpmn:messageFlow id="MsgFlow_1" name="rang-liste" sourceRef="Pool_NISpVU" targetRef="U_Start" />
    <bpmn:messageFlow id="MsgFlow_2" name="obavijest o nedostacima" sourceRef="U_T2" targetRef="Pool_NISpVU" />
    <bpmn:messageFlow id="MsgFlow_3" name="dorađena dokumentacija" sourceRef="Pool_NISpVU" targetRef="U_T3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_Uni" name="Sveučilište" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_Uni">
      <bpmn:lane id="Lane_Pool_Uni_1" name="Ured za studente i upise">
        <bpmn:flowNodeRef>U_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_GA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>U_T1</bpmn:flowNodeRef>
