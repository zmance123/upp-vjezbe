    <bpmn:sequenceFlow id="Flow_15" name="Da" sourceRef="G3" targetRef="T9" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="T10" targetRef="E4" />
    <bpmn:task id="T3" name="Odbiti reklamaciju">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1" name="Reklamacija odbijena">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
